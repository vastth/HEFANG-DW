@echo off
REM ========================================================================
REM 何方珠宝 - 主链+销售专题总控调度脚本（Windows / V2 显式切换）
REM 用于人工触发或任务计划显式执行 --cutover-mode v2
REM ========================================================================

chcp 65001 >nul
cd /d %~dp0

echo ========================================================================
echo   何方珠宝总控调度（V2 显式切换）
echo   开始时间: %date% %time%
if not "%~1"=="" echo   追加参数: %*
echo ========================================================================

python scheduled_total_control.py --cutover-mode v2 %*

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ✓ V2 总控调度执行成功
    echo ========================================================================
    exit /b 0
) else (
    echo.
    echo ✗ V2 总控调度执行失败，错误码: %ERRORLEVEL%
    echo ========================================================================
    exit /b %ERRORLEVEL%
)