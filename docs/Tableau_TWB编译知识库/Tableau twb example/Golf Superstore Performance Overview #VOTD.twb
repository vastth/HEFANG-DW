          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eonwid1j60e8g1d7k7py1vry7v1'>
            <column caption='parameter current year' datatype='boolean' name='[Calculation_1525031475984461824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [Order Date]) = [Parameters].[Parameter 1]&#13;&#10;AND&#13;&#10;DATEPART(&apos;month&apos;, [Order Date]) &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='parameter last year' datatype='boolean' name='[Calculation_1525031475984633857]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [Order Date]) = [Parameters].[Parameter 1] - 1&#13;&#10;AND&#13;&#10;DATEPART(&apos;month&apos;, [Order Date]) &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Sales CY' datatype='real' name='[Calculation_1525031475984699394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Calculation_1525031475984461824]&#13;&#10;when TRUE then [Sales] END)' />
            </column>
            <column caption='Sales % change' datatype='real' name='[Calculation_1525031475987349508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1525031475984699394] - [Sales CY (copy)_1525031475985330179])&#13;&#10;/&#13;&#10;[Sales CY (copy)_1525031475985330179]' />
            </column>
            <column caption='Metrics CY' datatype='real' name='[Calculation_1525031476270342162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN 1 THEN [Calculation_1525031475984699394]&#13;&#10;WHEN 2 THEN [Sales CY (copy)_1525031476243845126]&#13;&#10;WHEN 3 THEN [Profit CY (copy)_1525031476247953418]&#13;&#10;WHEN 4 THEN [Profit CY (copy)_1525031476261310479]&#13;&#10;END' />
            </column>
            <column caption='dot segment' datatype='string' name='[Calculation_801922261869117459]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Metrics CY (copy)_1525031476323471404] &lt; 0 THEN&#13;&#10;    &apos;●&apos;&#13;&#10;ELSE&#13;&#10;    &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Comparison Last Year' datatype='integer' name='[Calculation_801922263200956468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] - 1' />
            </column>
            <column caption='CY String' datatype='string' name='[Calculation_801922263351205958]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN 1 THEN &apos;£&apos;+STR(ROUND([Calculation_1525031475984699394]/1000,1)) + &apos;k&apos;&#13;&#10;    WHEN 2 THEN &apos;£&apos;+STR(ROUND([Sales CY (copy)_1525031476243845126]/1000, 1))+&apos;k&apos;&#13;&#10;    WHEN 3 THEN STR([Profit CY (copy)_1525031476247953418])&#13;&#10;    ELSE STR([Profit CY (copy)_1525031476261310479])&#13;&#10;END' />
            </column>
            <column caption='PY String' datatype='string' name='[Calculation_801922263351750727]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN 1 THEN &apos;£&apos;+STR(ROUND([Sales CY (copy)_1525031475985330179]/1000, 1))+&apos;k&apos;&#13;&#10;    WHEN 2 THEN &apos;£&apos;+STR(ROUND([Sales PY (copy)_1525031476243935239]/1000, 1))+&apos;k&apos;&#13;&#10;    WHEN 3 THEN STR([Sales PY (copy)_1525031476249096203])&#13;&#10;    ELSE STR([Orders PY  (copy)_1525031476261199886])&#13;&#10;END' />
            </column>
