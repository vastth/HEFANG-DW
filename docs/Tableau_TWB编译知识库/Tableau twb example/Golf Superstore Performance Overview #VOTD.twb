            <column caption='Sales % change' datatype='real' name='[Calculation_1525031475987349508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1525031475984699394] - [Sales CY (copy)_1525031475985330179])&#13;&#10;/&#13;&#10;[Sales CY (copy)_1525031475985330179]' />
            </column>
            <column caption='Metrics CY' datatype='real' name='[Calculation_1525031476270342162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN 1 THEN [Calculation_1525031475984699394]&#13;&#10;WHEN 2 THEN [Sales CY (copy)_1525031476243845126]&#13;&#10;WHEN 3 THEN [Profit CY (copy)_1525031476247953418]&#13;&#10;WHEN 4 THEN [Profit CY (copy)_1525031476261310479]&#13;&#10;END' />
            </column>
            <column caption='dot segment' datatype='string' name='[Calculation_801922261869117459]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Metrics CY (copy)_1525031476323471404] &lt; 0 THEN&#13;&#10;    &apos;●&apos;&#13;&#10;ELSE&#13;&#10;    &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Comparison Last Year' datatype='integer' name='[Calculation_801922263200956468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] - 1' />
