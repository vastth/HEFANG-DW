              <calculation class='tableau' formula='countd(CASE [Calculation_1525031475984633857]&#13;&#10;when TRUE then [Customer ID] END)' />
            </column>
            <column caption='orders CY ' datatype='integer' name='[Profit CY (copy)_1525031476247953418]' role='measure' type='quantitative'>
