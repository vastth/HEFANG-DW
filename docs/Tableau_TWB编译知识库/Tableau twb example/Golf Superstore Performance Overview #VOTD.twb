            <column caption='CY String' datatype='string' name='[Calculation_801922263351205958]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN 1 THEN &apos;£&apos;+STR(ROUND([Calculation_1525031475984699394]/1000,1)) + &apos;k&apos;&#13;&#10;    WHEN 2 THEN &apos;£&apos;+STR(ROUND([Sales CY (copy)_1525031476243845126]/1000, 1))+&apos;k&apos;&#13;&#10;    WHEN 3 THEN STR([Profit CY (copy)_1525031476247953418])&#13;&#10;    ELSE STR([Profit CY (copy)_1525031476261310479])&#13;&#10;END' />
