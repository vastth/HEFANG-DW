                <zone fixed-size='280' h='32900' id='400' is-fixed='true' is-scaled='1' param='Image/Inspiration.PNG' type-v2='bitmap' w='26754' x='17173' y='21000'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#1b242cb4' />
                  </zone-style>
                </zone>
                <zone fixed-size='239' forceUpdate='true' h='23900' id='407' type-v2='text' w='15130' x='4576' y='58100'>
                  <formatted-text>
                    <run fontcolor='#e5e5e5' fontname='Tableau Bold' fontsize='14'>4. Data Model</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>The data model is made of  two independent datasets:</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>1. Filtered dataset - a dataset with all the customers and their email metrics</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>2. Sankey dataset - a dataset that is used to build the Sankey funnel chart</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='534' forceUpdate='true' h='33300' id='364' type-v2='text' w='37272' x='23732' y='58100'>
                  <formatted-text>
                    <run fontcolor='#e5e5e5' fontname='Tableau Bold' fontsize='14'>5. Code Snippets</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ee1c4d' fontname='Tableau Bold' fontsize='11'>Generating fake data</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>account_number = faker.random_number(digits=8)</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#ee1c4d' fontname='Tableau Bold' fontsize='11'>Defining custom functions</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>def filter_email_2(df):</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>    return df[df[&apos;email_name&apos;].str.contains(&apos;Email 1|Email 2|Email 3&apos;)]</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#ee1c4d' fontname='Tableau Bold' fontsize='11'>Renaming columns</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>grouped_counts = grouped_counts.rename(columns={&quot;Email 1&quot;: &quot;Step 1&quot;, &quot;Email 2&quot;: &quot;Step 2&quot;....)</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#ee1c4d' fontname='Tableau Bold' fontsize='11'>Merging data frames</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>merged = pd.merge(grouped_counts, model, on=&apos;Link&apos;)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='33300' id='382' type-v2='text' w='34420' x='61004' y='58100'>
                  <formatted-text>
                    <run fontcolor='#ee1c4d' fontname='Tableau Bold' fontsize='11'>Pivoting data </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>df_pivoted = df.pivot(index=&apos;name&apos;, columns=&apos;email_name&apos;, values=&apos;email_name&apos;)</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#ee1c4d' fontname='Tableau Bold' fontsize='11'>For loops</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>        for j in email_sequence:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>            if name not in emails_sent:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>                emails_sent[name] = [j]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'><![CDATA[            elif len(emails_sent[name]) < max_emails_per_person and j not in emails_sent[name]:]]></run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>                emails_sent[name].append(j)</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#ee1c4d' fontname='Tableau Bold' fontsize='11'>Reading Excel files</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e5e5e5' fontsize='11'>df = pd.read_csv(r&apos;C:\Users\Marius\Desktop\Email Marketing\unfiltered_dataset.csv&apos;)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
