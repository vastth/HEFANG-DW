    <worksheet lock-quick-filters='true' name='Curve 1-2'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <repository-location derived-from='https://vizhub/workbooks/EmailMarketingCampaignDashboard_16951221887730/Curve1-2?rev=' id='86214101' path='/workbooks/EmailMarketingCampaignDashboard_16951221887730' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='sankey_data' name='federated.1wzns410i41r26133ghzi0xsokju' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Whitespace' datatype='real' name='[Parameter 1 1]' param-domain-type='range' role='measure' type='quantitative' value='0.56928464232116049'>
              <calculation class='tableau' formula='0.56928464232116049' />
              <range max='1.0' min='0.0' />
            </column>
            <column caption='Select the period' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;CM vs CM PY&quot;'>
              <calculation class='tableau' formula='&quot;CM vs CM PY&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wzns410i41r26133ghzi0xsokju'>
            <column caption='Sankey Filter' datatype='boolean' name='[Calculation_1037235351386542080]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 2]=&quot;Yearly&quot; OR [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN [Month/Year]=&quot;Year&quot;&#13;&#10;ELSE [Month/Year]=&quot;Month&quot;&#13;&#10;END' />
            </column>
            <column caption='t Adjusted' datatype='real' name='[Calculation_1128714698028355584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Adjust our model values to use sine curve.&#13;&#10;([t] /4)' />
            </column>
            <column caption='N1 Flow Size' datatype='real' name='[Calculation_1490329120836378 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// We want the scale to always be 0 to 1.&#13;&#10;// Thus, we must adjust the flow size to account for...&#13;&#10;// ...the number of whitespaces.&#13;&#10;(SUM([Size])*(1 - SIZE()*[Calculation_604889763570143232]))/TOTAL(SUM([Size]))'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1wzns410i41r26133ghzi0xsokju].[Step 1]' />
                  <order field='[federated.1wzns410i41r26133ghzi0xsokju].[Step 2]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='Curve 1-2 Max' datatype='real' name='[Calculation_1490329122549987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_8950329121202785] + (([Calculation_5790329121624550] - [Calculation_8950329121202785]) * ATTR([Calculation_2810329120811267]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Curve 1-2 Polygon' datatype='real' name='[Calculation_1880329122906425]' role='measure' type='quantitative'>
