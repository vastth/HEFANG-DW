            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c04wdt1hijpaa177vcss0dptepn'>
            <column caption='&quot;Revenue&quot;' datatype='string' name='[&quot;Emails Sent&quot; (copy)_1378945961649496089]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Revenue&quot;' />
            </column>
            <column caption='Latest Period' datatype='string' default-format='*mmmm yyyy' name='[Calculation_1727130507495256071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN LEFT(STR(DATETRUNC(&apos;year&apos;,{MAX([sent_date])})),4)&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN &quot;YTD&quot;&#13;&#10;ELSE LEFT(STR(DATETRUNC(&apos;month&apos;,{MAX([sent_date])})),7)&#13;&#10;END' />
            </column>
            <column caption='Emails Rev - Latest Month' datatype='real' default-format='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' name='[Emails Sent - Latest Month (copy)_1378945961648640022]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;SUM(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [transaction_amount] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;SUM(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [transaction_amount] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;SUM(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;THEN [transaction_amount] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Emails Rev - Prior Month' datatype='real' default-format='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' name='[Emails Sent - Prior Month (copy)_1378945961648959511]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;SUM(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;THEN [transaction_amount] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;CM vs CM PY&quot; THEN &#13;&#10;SUM(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;THEN [transaction_amount] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;SUM(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;THEN [transaction_amount] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;SUM(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;THEN [transaction_amount] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Emails Rev Difference %' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%;0.0%' name='[Emails Sent Difference % (copy)_1378945961649360920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Emails Sent - Latest Month (copy)_1378945961648640022]/[Emails Sent - Prior Month (copy)_1378945961648959511])-1' />
            </column>
            <column caption='Previous Period' datatype='string' default-format='*mmmm yyyy' name='[Latest Month (copy)_1727130507495632904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN LEFT(STR(DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))),4)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;CM vs CM PY&quot; THEN LEFT(STR(DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))),7)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN &quot;PYTD&quot;&#13;&#10;&#13;&#10;ELSE LEFT(STR(DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))),7)&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_1727130507495256071]' derivation='Attribute' name='[attr:Calculation_1727130507495256071:nk]' pivot='key' type='nominal' />
