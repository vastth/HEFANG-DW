            <column-instance column='[&quot;Emails Sent&quot; (copy)_1378945961649496089]' derivation='None' name='[none:&quot;Emails Sent&quot; (copy)_1378945961649496089:nk]' pivot='key' type='nominal' />
            <column-instance column='[email_name]' derivation='None' name='[none:email_name:nk]' pivot='key' type='nominal' />
