          <formatted-text>
            <run fontcolor='#e6e6e6' fontsize='10'>Metric: </run>
            <run bold='true' fontcolor='#e6e6e6' fontsize='10' underline='true'>&lt;[Parameters].[Parameter 1]&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='filtered_dataset' name='federated.1c04wdt1hijpaa177vcss0dptepn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select the metric to show' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Revenue&quot;'>
              <calculation class='tableau' formula='&quot;Revenue&quot;' />
            </column>
            <column caption='Select the period' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;CM vs CM PY&quot;'>
              <calculation class='tableau' formula='&quot;CM vs CM PY&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c04wdt1hijpaa177vcss0dptepn'>
            <column caption='Chart value' datatype='real' name='[Calculation_1378945961631494153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Emails Sent&quot; THEN COUNT([sent_date])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Open Rate&quot; THEN [Calculation_589408647825113088]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Click Rate&quot; THEN [Open Rate (copy)_589408647826395137]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Revenue&quot; THEN SUM([transaction_amount])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Conversion Rate&quot; THEN [Calculation_913949295995990016]&#13;&#10;ELSE [Calculation_913949295996895233]&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='datetime' name='[Calculation_1378945961644613649]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN DATETRUNC(&apos;year&apos;, [sent_date])&#13;&#10;ELSE DATETRUNC(&apos;month&apos;,[sent_date]) END' />
            </column>
            <column caption='MIN(0.0)' datatype='real' name='[Calculation_165788820933345281]' role='measure' type='quantitative' user:unnamed='All - Chart'>
              <calculation class='tableau' formula='MIN(0.0)' />
            </column>
            <column caption='Date String 1 Letter' datatype='string' name='[Calculation_165788820935966723]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN LEFT(STR([Calculation_1378945961644613649]),4)&#13;&#10;ELSE LEFT(STR(DATENAME(&apos;month&apos;,[Calculation_1378945961644613649])),1)&#13;&#10;END' />
            </column>
            <column caption='Max Sent Date' datatype='datetime' name='[Calculation_2251851693727747]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED: MAX([sent_date])}' />
            </column>
            <column caption='Max Sent Date -12' datatype='datetime' name='[Calculation_2251851694211076]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Monthly&quot; THEN DATEADD(&apos;month&apos;,-11, DATETRUNC(&apos;month&apos;,[Calculation_2251851693727747]))&#13;&#10;ELSE DATEADD(&apos;year&apos;,-11,DATETRUNC(&apos;year&apos;, [Calculation_2251851693727747]))&#13;&#10;END' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_2251851694555141]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Monthly&quot; THEN [sent_date]&lt;=[Calculation_2251851693727747] &#13;&#10;AND [sent_date]&gt;[Calculation_2251851694211076]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;CM vs CM PY&quot; THEN [sent_date]&lt;=[Calculation_2251851693727747] &#13;&#10;AND [sent_date]&gt;[Max Sent Date -12 (copy)_2885681529824837637]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;&#13;&#10;ELSE [sent_date]&lt;=[Calculation_2251851693727747] &#13;&#10;END' />
            </column>
            <column caption='Open Rate' datatype='real' name='[Calculation_589408647825113088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([open_date])/COUNT([sent_date])*100' />
            </column>
            <column caption='Conversion Rate' datatype='real' name='[Calculation_913949295995990016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([transaction_amount])/COUNT([sent_date])*100' />
            </column>
            <column caption='Bounce Rate' datatype='real' name='[Calculation_913949295996895233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([bounce_date])/COUNT([sent_date])*100' />
