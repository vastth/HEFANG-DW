      <repository-location derived-from='https://vizhub/workbooks/EmailMarketingCampaignDashboard_16951221887730/2-BANEmailConversions?rev=' id='86214079' path='/workbooks/EmailMarketingCampaignDashboard_16951221887730' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='filtered_dataset' name='federated.1c04wdt1hijpaa177vcss0dptepn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select the period' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;CM vs CM PY&quot;'>
              <calculation class='tableau' formula='&quot;CM vs CM PY&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c04wdt1hijpaa177vcss0dptepn'>
            <column caption='&quot;Conversion Rate&quot;' datatype='string' name='[&quot;Click Rate&quot; (copy)_1378945961652334623]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Conversion Rate&quot;' />
            </column>
            <column caption='Emails Sent - Latest Month' datatype='integer' name='[Calculation_1727130507484217346]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Latest Period' datatype='string' default-format='*mmmm yyyy' name='[Calculation_1727130507495256071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN LEFT(STR(DATETRUNC(&apos;year&apos;,{MAX([sent_date])})),4)&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN &quot;YTD&quot;&#13;&#10;ELSE LEFT(STR(DATETRUNC(&apos;month&apos;,{MAX([sent_date])})),7)&#13;&#10;END' />
            </column>
            <column caption='Emails Conv R Difference pp' datatype='real' default-format='*▲ 0.0 pp;▼ -0.0 pp ;0.0 pp' name='[Emails Click Difference pp (copy)_1378945961652138014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Emails Click Rate - Latest Month (copy)_1378945961651671068]*100-[Emails Click Rate - Prior Month (copy)_1378945961651982365]*100' />
            </column>
            <column caption='Emails Conv Rate - Latest Month' datatype='real' default-format='p0.0%' name='[Emails Click Rate - Latest Month (copy)_1378945961651671068]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Emails Clicked - Latest Month (copy)_1378945961651171354]/[Calculation_1727130507484217346]' />
            </column>
            <column caption='Emails Conv Rate - Prior Month' datatype='real' default-format='p0.0%' name='[Emails Click Rate - Prior Month (copy)_1378945961651982365]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Emails Clicked - Prior Month (copy)_1378945961651511323]/[Emails Sent - Latest Month (copy)_1727130507488231429]' />
            </column>
            <column caption='Emails Conv - Latest Month' datatype='integer' name='[Emails Clicked - Latest Month (copy)_1378945961651171354]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [transaction_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [transaction_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;THEN [transaction_date] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Emails Conv - Prior Month' datatype='integer' name='[Emails Clicked - Prior Month (copy)_1378945961651511323]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;THEN [transaction_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;CM vs CM PY&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;THEN [transaction_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;THEN [transaction_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;THEN [transaction_date] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Emails Sent - Prior Month' datatype='integer' name='[Emails Sent - Latest Month (copy)_1727130507488231429]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;CM vs CM PY&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Previous Period' datatype='string' default-format='*mmmm yyyy' name='[Latest Month (copy)_1727130507495632904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN LEFT(STR(DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))),4)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;CM vs CM PY&quot; THEN LEFT(STR(DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))),7)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN &quot;PYTD&quot;&#13;&#10;&#13;&#10;ELSE LEFT(STR(DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))),7)&#13;&#10;END' />
            </column>
