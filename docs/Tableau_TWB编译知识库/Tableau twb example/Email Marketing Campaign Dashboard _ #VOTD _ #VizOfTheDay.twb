              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Emails Sent&quot; THEN STR([Calculation_1378945961631494153])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Open Rate&quot; THEN STR(ROUND([Calculation_1378945961631494153],1))+&quot;%&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Click Rate&quot; THEN STR(ROUND([Calculation_1378945961631494153],1))+&quot;%&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Revenue&quot; THEN &quot;£&quot; + REGEXP_REPLACE(STR(LEFT(STR(ROUND([Calculation_1378945961631494153])),FIND(STR([Calculation_1378945961631494153]),&apos;.&apos;)-1)), &quot;\d{1,3}(?=(\d{3})+(?!\d))&quot;, &quot;$0,&quot;)&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Conversion Rate&quot; THEN STR(ROUND([Calculation_1378945961631494153],1))+&quot;%&quot;&#13;&#10;ELSE STR(ROUND([Calculation_1378945961631494153],1))+&quot;%&quot;&#13;&#10;END' />
            </column>
