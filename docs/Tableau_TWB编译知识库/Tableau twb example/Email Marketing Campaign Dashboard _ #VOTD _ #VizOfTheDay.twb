            <column-instance column='[Emails Sent - Latest Month (copy)_1378945961648640022]' derivation='User' name='[usr:Emails Sent - Latest Month (copy)_1378945961648640022:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Emails Sent - Prior Month (copy)_1378945961648959511]' derivation='User' name='[usr:Emails Sent - Prior Month (copy)_1378945961648959511:ok]' pivot='key' type='ordinal' />
