      <column caption='&quot;Emails Sent&quot;' datatype='string' name='[Calculation_1378945961630547973]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Emails Sent&quot;' />
      </column>
      <column caption='Chart value' datatype='real' name='[Calculation_1378945961631494153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Emails Sent&quot; THEN COUNT([sent_date])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Open Rate&quot; THEN [Calculation_589408647825113088]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Click Rate&quot; THEN [Open Rate (copy)_589408647826395137]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Revenue&quot; THEN SUM([transaction_amount])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Conversion Rate&quot; THEN [Calculation_913949295995990016]&#13;&#10;ELSE [Calculation_913949295996895233]&#13;&#10;END' />
      </column>
      <column caption='Date' datatype='datetime' name='[Calculation_1378945961644613649]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN DATETRUNC(&apos;year&apos;, [sent_date])&#13;&#10;ELSE DATETRUNC(&apos;month&apos;,[sent_date]) END' />
      </column>
      <column caption='Date String 1 Letter' datatype='string' name='[Calculation_165788820935966723]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN LEFT(STR([Calculation_1378945961644613649]),4)&#13;&#10;ELSE LEFT(STR(DATENAME(&apos;month&apos;,[Calculation_1378945961644613649])),1)&#13;&#10;END' />
      </column>
      <column caption='Opened' datatype='integer' name='[Calculation_1721501024365809665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([open_date]) THEN 0 ELSE 1 END' />
      </column>
      <column caption='Clicked' datatype='integer' name='[Calculation_1721501024369029123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([click_date]) THEN 0 ELSE 1 END' />
      </column>
      <column caption='Customer Type' datatype='string' name='[Calculation_1721501024371163140]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;{ FIXED [name]: MAX(CONTAINS([email_name], &quot;Email 1&quot;))}=FALSE&#13;&#10;AND&#13;&#10;{ FIXED [name]: MAX(CONTAINS([email_name], &quot;Email 2&quot;))}=TRUE&#13;&#10;THEN &quot;Existing Customer&quot; ELSE &quot;New Lead&quot;&#13;&#10;END' />
      </column>
      <column caption='Emails Sent - Latest Month' datatype='integer' name='[Calculation_1727130507484217346]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Emails Sent Difference %' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%;0.0%' name='[Calculation_1727130507488980998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1727130507484217346]/[Emails Sent - Latest Month (copy)_1727130507488231429])-1' />
      </column>
      <column caption='Latest Period' datatype='string' default-format='*mmmm yyyy' name='[Calculation_1727130507495256071]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN LEFT(STR(DATETRUNC(&apos;year&apos;,{MAX([sent_date])})),4)&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN &quot;YTD&quot;&#13;&#10;ELSE LEFT(STR(DATETRUNC(&apos;month&apos;,{MAX([sent_date])})),7)&#13;&#10;END' />
      </column>
      <column caption='Max Sent Date' datatype='datetime' name='[Calculation_2251851693727747]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED: MAX([sent_date])}' />
      </column>
      <column caption='Max Sent Date -12' datatype='datetime' name='[Calculation_2251851694211076]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Monthly&quot; THEN DATEADD(&apos;month&apos;,-11, DATETRUNC(&apos;month&apos;,[Calculation_2251851693727747]))&#13;&#10;ELSE DATEADD(&apos;year&apos;,-11,DATETRUNC(&apos;year&apos;, [Calculation_2251851693727747]))&#13;&#10;END' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_2251851694555141]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Monthly&quot; THEN [sent_date]&lt;=[Calculation_2251851693727747] &#13;&#10;AND [sent_date]&gt;[Calculation_2251851694211076]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;CM vs CM PY&quot; THEN [sent_date]&lt;=[Calculation_2251851693727747] &#13;&#10;AND [sent_date]&gt;[Max Sent Date -12 (copy)_2885681529824837637]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;&#13;&#10;ELSE [sent_date]&lt;=[Calculation_2251851693727747] &#13;&#10;END' />
      </column>
      <column caption='&quot;Yearly&quot;' datatype='string' name='[Calculation_356347322027663362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Yearly&quot;' />
      </column>
      <column caption='Open Rate' datatype='real' name='[Calculation_589408647825113088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([open_date])/COUNT([sent_date])*100' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_756886277671231488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [name]: COUNT([email_name])}' />
