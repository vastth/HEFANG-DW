              <calculation class='tableau' formula='// We want to evenly distribute the spacing...&#13;&#10;// ...so that the flows stay the same size...&#13;&#10;// ...regardless of the number of bars on each side.&#13;&#10;[Parameters].[Parameter 1 1]/SIZE()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='N4 Bar Position' datatype='real' name='[N2 Bar Position (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(ATTR([Step 4])) OR ATTR([Step 4])=&quot;&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    RUNNING_SUM([N1 Flow Size (copy) (copy) (copy)]+ [N1 Whitespace (copy 3)]) - [N1 Flow Size (copy) (copy) (copy)] - [N1 Whitespace (copy 3)]/2&#13;&#10;END'>
                <table-calc ordering-field='[federated.1wzns410i41r26133ghzi0xsokju].[Step 1]' ordering-type='Field' />
              </calculation>
            </column>
            <column datatype='integer' name='[Size]' role='measure' type='quantitative' />
