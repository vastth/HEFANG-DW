              <calculation class='tableau' formula='[Emails Click Rate - Latest Month (copy)_1378945961651671068]*100-[Emails Click Rate - Prior Month (copy)_1378945961651982365]*100' />
            </column>
            <column caption='Emails Conv Rate - Latest Month' datatype='real' default-format='p0.0%' name='[Emails Click Rate - Latest Month (copy)_1378945961651671068]' role='measure' type='ordinal'>
