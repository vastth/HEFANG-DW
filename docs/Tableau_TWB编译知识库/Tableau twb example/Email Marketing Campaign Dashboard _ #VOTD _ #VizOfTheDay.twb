      <repository-location derived-from='https://vizhub/workbooks/EmailMarketingCampaignDashboard_16951221887730/1-Chart?rev=' id='86214074' path='/workbooks/EmailMarketingCampaignDashboard_16951221887730' revision='' />
      <layout-options>
