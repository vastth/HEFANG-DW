        <calculation class='tableau' formula='IF  [Parameters].[Parameter 2]=&quot;Yearly&quot; OR [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN [Month/Year]=&quot;Year&quot;&#13;&#10;ELSE [Month/Year]=&quot;Month&quot;&#13;&#10;END' />
