      <repository-location derived-from='https://vizhub/workbooks/EmailMarketingCampaignDashboard_16951221887730/2-Chart?rev=' id='86214081' path='/workbooks/EmailMarketingCampaignDashboard_16951221887730' revision='' />
      <layout-options>
