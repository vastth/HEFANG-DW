        <calculation class='tableau' formula='IF ISNULL(ATTR([Step 1])) OR ATTR([Step 1])=&quot;&quot; OR ISNULL(ATTR([Step 2])) OR ATTR([Step 2])=&quot;&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    CASE ATTR([Min or Max])&#13;&#10;    WHEN &apos;Min&apos; THEN [Calculation_8830329122759423]&#13;&#10;    WHEN &apos;Max&apos; THEN [Calculation_1490329122549987]&#13;&#10;    END&#13;&#10;END'>
