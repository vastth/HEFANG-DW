              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Latest Period' datatype='string' default-format='*mmmm yyyy' name='[Calculation_1727130507495256071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN LEFT(STR(DATETRUNC(&apos;year&apos;,{MAX([sent_date])})),4)&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN &quot;YTD&quot;&#13;&#10;ELSE LEFT(STR(DATETRUNC(&apos;month&apos;,{MAX([sent_date])})),7)&#13;&#10;END' />
