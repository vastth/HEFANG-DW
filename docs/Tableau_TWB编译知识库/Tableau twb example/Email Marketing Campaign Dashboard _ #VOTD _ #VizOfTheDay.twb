              <calculation class='tableau' formula='&quot;CM vs CM PY&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c04wdt1hijpaa177vcss0dptepn'>
            <column caption='&quot;Bounce Rate&quot;' datatype='string' name='[&quot;Click Rate&quot; (copy)_1378945961657344037]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Bounce Rate&quot;' />
            </column>
            <column caption='Emails Sent - Latest Month' datatype='integer' name='[Calculation_1727130507484217346]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Latest Period' datatype='string' default-format='*mmmm yyyy' name='[Calculation_1727130507495256071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN LEFT(STR(DATETRUNC(&apos;year&apos;,{MAX([sent_date])})),4)&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN &quot;YTD&quot;&#13;&#10;ELSE LEFT(STR(DATETRUNC(&apos;month&apos;,{MAX([sent_date])})),7)&#13;&#10;END' />
            </column>
            <column caption='Emails Bounce Difference pp' datatype='real' default-format='*▲ 0.0 pp;▼ -0.0 pp ;0.0 pp' name='[Emails Click Difference pp (copy)_1378945961657131044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Emails Click Rate - Latest Month (copy)_1378945961656872994]*100-[Emails Click Rate - Prior Month (copy)_1378945961657008163]*100' />
            </column>
            <column caption='Emails Bounce Rate - Latest Month' datatype='real' default-format='p0.0%' name='[Emails Click Rate - Latest Month (copy)_1378945961656872994]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Emails Clicked - Latest Month (copy)_1378945961656426528]/[Calculation_1727130507484217346]' />
            </column>
            <column caption='Emails Bounce Rate - Prior Month' datatype='real' default-format='p0.0%' name='[Emails Click Rate - Prior Month (copy)_1378945961657008163]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Emails Clicked - Prior Month (copy)_1378945961656733729]/[Emails Sent - Latest Month (copy)_1727130507488231429]' />
            </column>
            <column caption='Emails Bounced - Latest Month' datatype='integer' name='[Emails Clicked - Latest Month (copy)_1378945961656426528]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [bounce_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATETRUNC(&apos;year&apos;,{MAX([sent_date])})&#13;&#10;THEN [bounce_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATETRUNC(&apos;month&apos;,{MAX([sent_date])})&#13;&#10;THEN [bounce_date] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Emails Bounced - Prior Month' datatype='integer' name='[Emails Clicked - Prior Month (copy)_1378945961656733729]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;THEN [bounce_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;CM vs CM PY&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;THEN [bounce_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;THEN [bounce_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [bounce_date]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([bounce_date])}))&#13;&#10;THEN [bounce_date] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Emails Sent - Prior Month' datatype='integer' name='[Emails Sent - Latest Month (copy)_1727130507488231429]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Yearly&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;year&apos;, [sent_date]) = DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;CM vs CM PY&quot; THEN &#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;YTD vs PYTD&quot; THEN&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) &lt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;AND DATETRUNC(&apos;year&apos;, [sent_date]) &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,{MAX([sent_date])}))&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;ELSE&#13;&#10;COUNT(&#13;&#10;IF DATETRUNC(&apos;month&apos;, [sent_date]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([sent_date])}))&#13;&#10;THEN [sent_date] END&#13;&#10;)&#13;&#10;&#13;&#10;END' />
