      <aliases enabled='yes' />
      <column datatype='string' name='[Booking Status]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Booking Value]' role='measure' type='quantitative' />
      <column caption='Date Range' datatype='string' name='[Calculation_0091051233165312]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(DATENAME(&apos;month&apos;, MIN([Date]))) + &quot; &quot; +&#13;&#10;STR(YEAR(MIN([Date]))) &#13;&#10;+ &quot; to &quot; +&#13;&#10;STR(DATENAME(&apos;month&apos;, MAX([Date]))) + &quot; &quot; +&#13;&#10;STR(YEAR(MAX([Date])))' />
      </column>
      <column caption='Calculation3' datatype='string' name='[Calculation_0423926245515264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Booking Status] = &quot;Completed&quot; THEN &quot;Good&quot;&#13;&#10;ELSEIF [Booking Status] = &quot;Cancelled by Driver&quot; &#13;&#10;   OR [Booking Status] = &quot;Cancelled by Customer&quot; THEN &quot;Bad&quot;&#13;&#10;ELSE &quot;Warning&quot;&#13;&#10;END' />
      </column>
      <column caption='status' datatype='string' name='[Calculation_0423926247624705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Booking Status] = &quot;Completed&quot; THEN &quot;● Completed&quot;&#13;&#10;ELSEIF [Booking Status] = &quot;Cancelled by Driver&quot; THEN &quot;● Cancelled by Driver&quot;&#13;&#10;ELSEIF [Booking Status] = &quot;Cancelled by Customer&quot; THEN &quot;● Cancelled by Customer&quot;&#13;&#10;ELSE &quot;● Incomplete&quot;&#13;&#10;END' />
      </column>
      <column caption='Hour field' datatype='integer' name='[Calculation_0479451211128833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [Time])' />
      </column>
      <column caption='Day Field' datatype='string' name='[Calculation_0479451211194370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [Date])' />
      </column>
      <column caption='Calculation2' datatype='string' name='[Calculation_0479451213017091]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATENAME(&apos;weekday&apos;,[Date]) IN (&quot;Saturday&quot;,&quot;Sunday&quot;)&#13;&#10;THEN &quot;Weekend&quot;&#13;&#10;ELSE &quot;Weekday&quot;&#13;&#10;END' />
      </column>
      <column caption='Vehicle Type (Calc)' datatype='string' name='[Calculation_0479451260076036]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Vehicle Type] = &apos;Go&apos; THEN &apos;Premium&apos;&#13;&#10;ELSE [Vehicle Type]&#13;&#10;END' />
      </column>
      <column caption='Total Bookings' datatype='integer' name='[Calculation_0641627814871041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Booking ID])' />
      </column>
      <column caption='Total Revenue' datatype='integer' name='[Calculation_0641627815608322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Booking Value])' />
      </column>
      <column caption='Total Distance' datatype='real' name='[Calculation_0641627816198147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Ride Distance])' />
      </column>
      <column caption='AVG. Distance' datatype='real' name='[Calculation_0641627816566788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Ride Distance])' />
      </column>
      <column caption='Lost Bookings' datatype='integer' name='[Calculation_0641627816914949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;IF LOWER([Booking Status]) IN (&quot;cancelled&quot;,&quot;canceled&quot;,&quot;no show&quot;,&quot;incomplete&quot;) &#13;&#10;THEN [Booking ID] &#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Completition Raate' datatype='real' name='[Calculation_0641627817525254]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;IF [Booking Status] = &quot;Completed&quot; THEN [Booking ID] END&#13;&#10;)&#13;&#10;/ COUNT([Booking ID])' />
      </column>
      <column caption='Ride status Group' datatype='string' name='[Calculation_0641627836473362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Booking Status] = &quot;Completed&quot; THEN &quot;Completed&quot;&#13;&#10;ELSE &quot;Not Completed&quot;&#13;&#10;END' />
      </column>
      <column caption='Revenue Per (KM)' datatype='real' name='[Calculation_0641627841155093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Booking Value]) / SUM([Ride Distance])' />
      </column>
      <column caption='Customer Booking Count' datatype='integer' name='[Calculation_0641627846483990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer ID] : COUNT([Booking ID]) }' />
      </column>
      <column caption='Customer Type' datatype='string' name='[Calculation_0641627846582295]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [Customer ID] : COUNT([Booking ID]) } = 1 THEN &quot;First Time&quot;&#13;&#10;ELSEIF { FIXED [Customer ID] : COUNT([Booking ID]) } = 2 THEN &quot;Return&quot;&#13;&#10;ELSE &quot;Regular&quot;&#13;&#10;END' />
      </column>
      <column caption='First time' datatype='integer' name='[Calculation_0641627847213080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;IF [Calculation_0641627846582295] = &quot;First Time&quot; THEN [Booking ID] END&#13;&#10;)' />
      </column>
      <column caption='Return' datatype='integer' name='[Calculation_0641627847487513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;IF [Calculation_0641627846582295] = &quot;Return&quot; THEN [Booking ID] END&#13;&#10;)' />
      </column>
      <column caption='Regular' datatype='integer' name='[Calculation_0641627847557146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;IF [Calculation_0641627857244194] = &quot;Regular&quot; THEN [Booking ID] END&#13;&#10;)' />
      </column>
      <column caption='First Time Remaining' datatype='integer' name='[Calculation_0641627850117147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='650 - [Calculation_0641627847213080]' />
      </column>
      <column caption='Return Remaining' datatype='integer' name='[Calculation_0641627854987296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='650 - [Calculation_0641627847487513]' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_0641627857244194]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER(TRIM([Calculation_0641627846582295])), &quot;regular&quot;) THEN &quot;Regular&quot;&#13;&#10;ELSEIF CONTAINS(LOWER(TRIM([Calculation_0641627846582295])), &quot;return&quot;) THEN &quot;Return&quot;&#13;&#10;ELSEIF CONTAINS(LOWER(TRIM([Calculation_0641627846582295])), &quot;first&quot;) THEN &quot;First Time&quot;&#13;&#10;END' />
      </column>
      <column caption='Regular Remaining ' datatype='integer' name='[Return Remaining (copy)_0641627856429089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='650 - [Calculation_0641627847557146]' />
      </column>
