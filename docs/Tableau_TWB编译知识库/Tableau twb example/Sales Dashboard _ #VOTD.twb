              <calculation class='tableau' formula='IF SIGN([% change quan (copy)_530298863765917710]) = 1&#13;&#10;THEN &apos;Y&apos;&#13;&#10;ELSEIF SIGN([% change quan (copy)_530298863765917710]) = -1&#13;&#10;THEN &apos;N&apos;&#13;&#10;END' />
