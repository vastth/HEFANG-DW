      <column caption='% change Customers - ' datatype='real' default-format='*▼#0.00%' name='[% change Metrics (copy) (copy)_521854626790633499 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [% change quantity (copy)_298926444208484358]&lt;0&#13;&#10;THEN ABS(([Current Year Quantity (copy)_298926444208484360] - [Prior Year Quantity (copy)_298926444208484361])/[Prior Year Quantity (copy)_298926444208484361])&#13;&#10;END' />
      </column>
      <column caption='% change Quantity -' datatype='real' default-format='*▼#0.00%' name='[% change Metrics (copy) (copy)_521854626790633499 2 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Current Year Quantity (copy)_530298863764148236] &lt; 0&#13;&#10;THEN ABS(([Current Year Revenue (copy)_530298863754567684] - [Prior Year Revenue (copy)_530298863754579973])/[Prior Year Revenue (copy)_530298863754579973])&#13;&#10;END' />
      </column>
      <column caption='% change Revenue -' datatype='real' default-format='*▼#0.00%' name='[% change Metrics (copy) (copy)_521854626790633499 2 2]' role='measure' type='quantitative'>
