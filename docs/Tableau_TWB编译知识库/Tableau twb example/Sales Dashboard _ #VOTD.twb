      <column caption='Metrics for Table' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_920986144794488833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Change Metric (copy)_920986144794435584]&#13;&#10;    WHEN &apos;Profit&apos; THEN AVG([Profit])&#13;&#10;    WHEN &apos;Quantity&apos; THEN AVG([Quantity])&#13;&#10;    WHEN &apos;Revenue&apos; THEN AVG([Sales])&#13;&#10;END' />
