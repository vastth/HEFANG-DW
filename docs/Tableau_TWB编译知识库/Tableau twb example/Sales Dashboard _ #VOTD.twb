    <worksheet name='Top 5 State Prof'>
      <table>
        <view>
          <datasources>
            <datasource caption='sales_data_sample' name='federated.1by3g3512g18k31cnbwab1p4bvi7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='2023' caption='Select Year' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
              <aliases>
                <alias key='2021' value='2021' />
                <alias key='2022' value='2022' />
                <alias key='2023' value='2023' />
              </aliases>
            </column>
            <column caption='Change Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Revenue&quot;'>
              <calculation class='tableau' formula='&quot;Revenue&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1by3g3512g18k31cnbwab1p4bvi7'>
            <column caption='% change Profit -' datatype='real' default-format='*▼#0.00%' name='[% change Metrics (copy) (copy)_521854626790633499 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [% change revenue (copy)_530298863766446096] &lt; 0&#13;&#10;THEN ABS(([Current Year Revenue (copy)_530298863755640839] - [Current Year Sales (copy)_530298863755739144])/[Current Year Sales (copy)_530298863755739144])&#13;&#10;END' />
            </column>
            <column caption='% change Profit +' datatype='real' default-format='*▲#0.00 %' name='[% change quantity (copy)_298926444208484358 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [% change revenue (copy)_530298863766446096] &gt; 0&#13;&#10;THEN ABS(([Current Year Revenue (copy)_530298863755640839] - [Current Year Sales (copy)_530298863755739144])/[Current Year Sales (copy)_530298863755739144])&#13;&#10;END' />
            </column>
            <column caption='% change Profit' datatype='real' default-format='*▲#.#%;▼#.#%' name='[% change revenue (copy)_530298863766446096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Current Year Revenue (copy)_530298863755640839] - [Current Year Sales (copy)_530298863755739144])/[Current Year Sales (copy)_530298863755739144]' />
            </column>
            <column caption='Current Year Metric' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_298926444209827853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;Profit&apos; THEN [Current Year Revenue (copy)_530298863755640839]&#13;&#10;    WHEN &apos;Quantity&apos; THEN [Current Year Revenue (copy)_530298863754567684]&#13;&#10;    WHEN &apos;Revenue&apos; THEN [Calculation_530298863751356418]&#13;&#10;    WHEN &apos;Customers&apos; THEN [Current Year Quantity (copy)_298926444208484360]&#13;&#10;END)' />
            </column>
            <column caption='Colors for bars State' datatype='string' name='[Calculation_470626181184458752 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [State] : [Calculation_298926444209827853]} = { MAX({ FIXED [State] : [Calculation_298926444209827853]})}&#13;&#10;THEN &apos;Yes&apos;&#13;&#10;ELSE &apos;No&apos;&#13;&#10;END' />
            </column>
            <column caption='Current Year Revenue' datatype='real' default-format='n&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_530298863751356418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#13;&#10;THEN [Sales] &#13;&#10;END)' />
            </column>
            <column aggregation='Avg' caption='Previous Year' datatype='integer' default-format='n0;-0' name='[Calculation_75153839344111624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] - 1' />
            </column>
            <column caption='Current Year Customers' datatype='integer' default-format='n#,##0;-#,##0' name='[Current Year Quantity (copy)_298926444208484360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#13;&#10;THEN [Customer ID]&#13;&#10;END)' />
            </column>
            <column caption='Current Year Quantity' datatype='integer' default-format='n#,##0;-#,##0' name='[Current Year Revenue (copy)_530298863754567684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#13;&#10;THEN [Quantity]&#13;&#10;END)' />
            </column>
            <column caption='Current Year Profit' datatype='real' default-format='n&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Current Year Revenue (copy)_530298863755640839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#13;&#10;THEN [Profit]&#13;&#10;END)' />
            </column>
            <column caption='Prior Year Profit' datatype='real' default-format='n&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Current Year Sales (copy)_530298863755739144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Order Date]) = [Parameters].[Parameter 1] - 1&#13;&#10;THEN [Profit]&#13;&#10;END)' />
            </column>
            <column datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='n&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Profit]' role='measure' type='quantitative' />
