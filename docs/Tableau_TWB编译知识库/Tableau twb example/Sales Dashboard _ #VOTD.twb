      <column caption='Weeks or Months' datatype='string' hidden='true' name='[Calculation_920986144798027783]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &apos;Months&apos; THEN LEFT(DATENAME(&apos;month&apos;, [Order Date]),3)&#13;&#10;    WHEN &apos;Weeks&apos; THEN &#13;&#10;       IF DATETRUNC(&apos;quarter&apos;, [Order Date]) = DATEADD(&apos;quarter&apos;, -1, DATETRUNC(&apos;quarter&apos;, Today() + 1))&#13;&#10;       THEN STR(DATEPART(&apos;week&apos;, [Order Date]))&#13;&#10;       END&#13;&#10;END' />
