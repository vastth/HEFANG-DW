              <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = 1 THEN&#10;IF MIN([Tier]) != 1 &#10;THEN&#10;SUM([Number])/ SUM({EXCLUDE [Tier] : SUM(IF [Tier] = 1 THEN [Number] END)})&#10;END END' />
