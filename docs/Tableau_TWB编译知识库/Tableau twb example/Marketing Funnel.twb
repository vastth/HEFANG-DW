            <column caption='Drop Rate' datatype='real' name='[Calculation_3122683402408841217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 7] = 2&#10;THEN&#10;(ZN(SUM([Number])) - LOOKUP(ZN(SUM([Number])), -1)) / ABS(LOOKUP(ZN(SUM([Number])), -1))&#10;END'>
