        <column caption='Sort By | Transaction Records' datatype='string' name='[Sort By (copy)_1732689601612455979]' param-domain-type='list' role='measure' type='nominal' value='&quot;Latest Date&quot;'>
          <calculation class='tableau' formula='&quot;Latest Date&quot;' />
          <members>
            <member value='&quot;Highest Sales Gross&quot;' />
            <member value='&quot;Lowest Sales Gross&quot;' />
            <member value='&quot;Highest Quantity&quot;' />
