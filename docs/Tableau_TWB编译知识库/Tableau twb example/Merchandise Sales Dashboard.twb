            </column>
            <column caption='International/Domestic' datatype='string' name='[Calculation_197736183822921734]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [International Shipping]=&apos;Yes&apos; THEN &apos;International&apos; ELSE &apos;Domestic&apos; END' />
            </column>
            <column caption='Rating Category' datatype='string' name='[Calculation_197736183824367623]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Rating] &lt;= 2 THEN &quot;Dissatisfied&quot;&#10;ELSEIF [Rating] = 3 THEN &quot;Neutral&quot;&#10;ELSE &quot;Satisfied&quot;&#10;END' />
            </column>
            <column caption='AVG(0.0)' datatype='real' name='[Calculation_197736183827410957]' role='measure' type='quantitative' user:unnamed='Last Transaction'>
