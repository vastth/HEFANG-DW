            <column caption='Main Date: Month of Last Date' datatype='integer' name='[LinPack_820578735441098168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed: max(month( {fixed:max([Order Date])}))}' />
              <desc>
                <formatted-text>
                  <run>Main Date: Month of Last Date: Returns the Month of Last Date</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='YTD' datatype='boolean' name='[MTD (copy)_1732689601531297829]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [Order Date]) = [Parameters].[LinPack_204649104038505399]' />
            </column>
            <column caption='Performance Scope Transaction' datatype='boolean' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[Metrics Selected Perf. -  Value (copy 2)_1732689601531490342]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[LinPack_244997933925155163] &#13;&#10;WHEN &quot;CM_vs_PM&quot; THEN [Calculation_197736183976386594] &#13;&#10;WHEN &quot;CM_vs_PY&quot; THEN [Calculation_197736183976386594] &#13;&#10;WHEN &quot;CYTD_vs_PYTD&quot; THEN [MTD (copy)_1732689601531297829] &#13;&#10;WHEN &quot;NONE&quot;  THEN NULL &#13;&#10;END' />
              <desc>
