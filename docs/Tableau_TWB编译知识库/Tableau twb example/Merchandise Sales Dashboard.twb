        <calculation class='tableau' formula='// Sort by Sales Gross (Descending)&#10;IF [Parameters].[Sort By (copy)_1732689601612455979] = &apos;Highest Sales Gross&apos; THEN [Total Sales]&#10;&#10;// Sort by Sales Gross (Ascending)&#10;ELSEIF [Parameters].[Sort By (copy)_1732689601612455979] = &apos;Lowest Sales Gross&apos; THEN -[Total Sales]&#10;&#10;// Sort by Quantity (Descending)&#10;ELSEIF [Parameters].[Sort By (copy)_1732689601612455979] = &apos;Highest Quantity&apos; THEN [Quantity]&#10;&#10;// Sort by Quantity (Ascending)&#10;ELSEIF [Parameters].[Sort By (copy)_1732689601612455979] = &apos;Lowest Quantity&apos; THEN -[Quantity]&#10;&#10;// Sort by Date&#10;ELSEIF [Parameters].[Sort By (copy)_1732689601612455979] = &apos;Latest Date&apos; THEN INT([Order Date]) &#10;&#10;END' />
      </column>
