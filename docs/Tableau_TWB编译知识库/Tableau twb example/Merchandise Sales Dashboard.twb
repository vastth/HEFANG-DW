            </column>
            <column caption='Main Date: Year' datatype='integer' default-format='n0;-0' name='[LinPack_082428216872139652]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='YEAR([Order Date])' />
              <desc>
                <formatted-text>
                  <run>Main Date: Year: Returns the year of the date used for time series calculations in the data source [numeric format]</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Period: Name of Previous Month' datatype='string' name='[LinPack_109287257445456740]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[LinPack_691367604370291879] + &quot;-&quot; + RIGHT(STR([LinPack_762552179012968521]),2)' />
              <desc>
                <formatted-text>
                  <run>Period: Name of Previous Month: Name of Previous Month</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Metrics Selected  YTD  (Previous Year)' datatype='integer' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[LinPack_117695844105674237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [LinPack_082428216872139652] = [Parameters].[LinPack_204649104038505399] - 1 AND [LinPack_053780505677838290] &lt;= [Parameters].[LinPack_169733173702694507] THEN [Calculation_254383022497943554] ELSE NULL END)' />
              <desc>
                <formatted-text>
                  <run>Total Expenses  YTD  (Previous Year): Year-to-Date &apos;Total Expenses&apos; value for previous year (selected current year - 1)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Period: Name of Current Month' datatype='string' name='[LinPack_148008464151630551]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[LinPack_785732505685168922] + &quot;-&quot; + RIGHT(STR([Parameters].[LinPack_204649104038505399]),2)' />
              <desc>
                <formatted-text>
                  <run>Period: Name of Current Month: Name of Current Month</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Metrics Selected Perf. - Reference' datatype='integer' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[LinPack_299518518264299520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[LinPack_244997933925155163] &#13;&#10;WHEN &quot;CM_vs_PM&quot; THEN [LinPack_907877142617982768] &#13;&#10;WHEN &quot;CM_vs_PY&quot; THEN [LinPack_631388418431448967] &#13;&#10;WHEN &quot;ACT_vs_TGT&quot; THEN NULL &#13;&#10;WHEN &quot;CYTD_vs_PYTD&quot; THEN [LinPack_117695844105674237] &#13;&#10;WHEN &quot;YTDACT_vs_YTDTGT&quot; THEN NULL &#13;&#10;WHEN &quot;NONE&quot;  THEN NULL &#13;&#10;END' />
              <desc>
                <formatted-text>
                  <run>Total Expenses Perf. - Reference: &apos;Total Expenses&apos; value for Previous Period, Previous Period or target depending on user choice in &apos;Performance Scope&apos; selector</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Period: Month Number of Previous Month' datatype='integer' name='[LinPack_356241517115120208]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[LinPack_169733173702694507]=1 THEN &#13;&#10;12 &#13;&#10;ELSE &#13;&#10;[Parameters].[LinPack_169733173702694507]-1 &#13;&#10;END' />
              <desc>
