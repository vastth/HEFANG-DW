        <calculation class='tableau' formula='CASE [Parameters].[LinPack_244997933925155163] &#13;&#10;WHEN &quot;CM_vs_PM&quot; THEN [LinPack_907877142617982768] &#13;&#10;WHEN &quot;CM_vs_PY&quot; THEN [LinPack_631388418431448967] &#13;&#10;WHEN &quot;ACT_vs_TGT&quot; THEN NULL &#13;&#10;WHEN &quot;CYTD_vs_PYTD&quot; THEN [LinPack_117695844105674237] &#13;&#10;WHEN &quot;YTDACT_vs_YTDTGT&quot; THEN NULL &#13;&#10;WHEN &quot;NONE&quot;  THEN NULL &#13;&#10;END' />
