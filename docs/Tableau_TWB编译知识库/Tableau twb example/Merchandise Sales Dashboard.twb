      <column caption='threshold | bottom' datatype='integer' hidden='true' name='[Calculation_6758425343804882945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// &#10;IF [Parameters].[Parameter 4 1] &lt; 3&#10;THEN 1&#10;ELSEIF [Parameters].[Parameter 4 1] &gt; FLOOR({COUNTD([Order ID])}/[Parameters].[Parameter 3 1]) - 1&#10;THEN FLOOR({COUNTD([Order ID])}/[Parameters].[Parameter 3 1]) - 3&#10;ELSE [Parameters].[Parameter 4 1] - 2&#10;END' />
      </column>
      <column caption='threshold | top' datatype='integer' hidden='true' name='[Calculation_6758425343805247490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// &#10;IF [Parameters].[Parameter 4 1] &gt; FLOOR({COUNTD([Order ID])}/[Parameters].[Parameter 3 1]) - 1&#10;THEN FLOOR({COUNTD([Order ID])}/[Parameters].[Parameter 3 1]) + 1&#10;ELSEIF [Parameters].[Parameter 4 1] &lt; 3&#10;THEN 5&#10;ELSE [Parameters].[Parameter 4 1] + 2&#10;END' />
      </column>
      <column caption='theshold | tf' datatype='boolean' hidden='true' name='[Calculation_6758425343805394947]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// &#10;[Calculation_6727885308800892929] &gt;= MIN([Calculation_6758425343804882945])&#10;AND &#10;[Calculation_6727885308800892929] &lt;= MIN([Calculation_6758425343805247490])'>
          <table-calc ordering-type='Rows' />
