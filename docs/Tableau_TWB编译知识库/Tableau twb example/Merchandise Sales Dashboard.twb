              <calculation class='tableau' formula='-1*(([Parameters].[LinPack_204649104038505399]- [LinPack_082428216872139652])*12+([Parameters].[LinPack_169733173702694507] - [LinPack_053780505677838290]))' />
              <desc>
                <formatted-text>
                  <run>Period: Months to Current Month: Returns the number of Months between the selected Current Month and the reference date of the data source</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Main Date: Year of Last Date' datatype='integer' name='[LinPack_679446162057474188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed: max(year( {fixed:max([Order Date])}))}' />
              <desc>
                <formatted-text>
