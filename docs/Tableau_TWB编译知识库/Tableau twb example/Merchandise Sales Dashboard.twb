        <calculation class='tableau' formula='SUM(IF [LinPack_082428216872139652] = [Parameters].[LinPack_204649104038505399] - 1 AND [LinPack_053780505677838290] &lt;= [Parameters].[LinPack_169733173702694507] THEN [Calculation_254383022497943554] ELSE NULL END)' />
