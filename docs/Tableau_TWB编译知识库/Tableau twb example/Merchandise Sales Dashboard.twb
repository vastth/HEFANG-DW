          <bin default-name='false' value='&quot;30-32&quot;'>
            <value>30</value>
            <value>31</value>
            <value>32</value>
          </bin>
          <bin default-name='false' value='&quot;&gt;35&quot;'>
            <value>33</value>
            <value>34</value>
            <value>35</value>
          </bin>
        </calculation>
      </column>
      <column aggregation='Sum' datatype='integer' name='[Buyer Age]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Buyer Gender]' role='dimension' type='nominal' />
      <column caption='PP Metrics Selected' datatype='integer' name='[CP Metrics Selected (copy)_1547619804029386757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Filter Date (copy)_1547619804029186052] = True THEN [Calculation_254383022497943554] END)' />
      </column>
      <column caption='Total Days' datatype='integer' name='[Calculation_1547619804028383234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 4],[Parameters].[Start Date (copy)_197736184057262135])+1' />
      </column>
      <column caption='CP Metrics Selected' datatype='integer' name='[Calculation_1547619804028743683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_197736184055431222] = True THEN [Calculation_254383022497943554] END)' />
      </column>
      <column caption='Difference PP CP Metrics Selected' datatype='integer' name='[Calculation_1547619804029595654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1547619804028743683]-[CP Metrics Selected (copy)_1547619804029386757]' />
      </column>
      <column caption='Up Down | Difference Metrics Selected' datatype='string' name='[Calculation_1547619804030291975]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1547619804029595654] &gt; 0 &#10;THEN &apos;+&apos; &#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='total review' datatype='integer' hidden='true' name='[Calculation_1547619804075380745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Rating])' />
      </column>
      <column caption='Highlight Max Bubble' datatype='string' name='[Calculation_1732689601524678692]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [LinPack_628373556243785611] = WINDOW_MAX([LinPack_628373556243785611])&#10;THEN &quot;Max&quot;&#10;ELSE &quot;Others&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sort by Dimension' datatype='integer' hidden='true' name='[Calculation_1732689601533992999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;Highest Value&apos; THEN RANK(SUM([Calculation_254383022497943554]),&apos;desc&apos;)&#10;WHEN &apos;Highest Value&apos; THEN RANK(SUM([Calculation_254383022497943554]),&apos;asc&apos;)&#10;WHEN &apos;Latest Date&apos; THEN RANK(MIN(INT(DATETRUNC(&apos;day&apos;,[Order Date]))),&apos;desc&apos;)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sort by Field' datatype='integer' name='[Calculation_1732689601537171497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Sort by Revenue (Descending)&#10;IF [Parameters].[Parameter 5] = &apos;Highest Value&apos; THEN [Calculation_254383022497943554]&#10;&#10;// Sort by Revenue (Ascending)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Lowest Value&apos; THEN -[Calculation_254383022497943554]&#10;&#10;// Sort by Date&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Latest Date&apos; THEN INT([Order Date]) &#10;&#10;END' />
      </column>
      <column caption='Revenue' datatype='integer' name='[Calculation_1732689601563242538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Quantity]*[Sales Price]' />
      </column>
      <column caption='Buyer Location' datatype='spatial' hidden='true' name='[Calculation_197736183796609024]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT([Latitude],[Longitude])' />
      </column>
      <column caption='Rank' datatype='boolean' name='[Calculation_197736183806705668]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK([LinPack_628373556243785611])&lt;=1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='International/Domestic' datatype='string' name='[Calculation_197736183822921734]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [International Shipping]=&apos;Yes&apos; THEN &apos;International&apos; ELSE &apos;Domestic&apos; END' />
      </column>
      <column caption='Rating Category' datatype='string' name='[Calculation_197736183824367623]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Rating] &lt;= 2 THEN &quot;Dissatisfied&quot;&#10;ELSEIF [Rating] = 3 THEN &quot;Neutral&quot;&#10;ELSE &quot;Satisfied&quot;&#10;END' />
      </column>
      <column caption='Last Order Rank' datatype='integer' hidden='true' name='[Calculation_197736183831416850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(MAX([Order Date]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Satuan' datatype='string' name='[Calculation_197736183848882204]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=1 THEN &apos;$&apos; &#10;ELSEIF [Parameters].[Parameter 1]=3 THEN &apos;$&apos; &#10;ELSE &apos;&apos; &#10;END' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_197736183976386594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [Order Date]) = [Parameters].[LinPack_169733173702694507]&#10;AND DATEPART(&apos;year&apos;, [Order Date]) = [Parameters].[LinPack_204649104038505399]' />
      </column>
      <column caption='Date Dimension' datatype='datetime' name='[Calculation_197736184047599665]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2], [Order Date])' />
      </column>
      <column caption='Max Sales' datatype='integer' name='[Calculation_197736184048033842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_254383022497943554]) = WINDOW_MAX(SUM([Calculation_254383022497943554]))&#10;THEN SUM([Calculation_254383022497943554])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Filter Date' datatype='boolean' name='[Calculation_197736184055431222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Order Date] &gt;= [Parameters].[Parameter 4] &#10;AND &#10;[Order Date] &lt;= [Parameters].[Start Date (copy)_197736184057262135]' />
      </column>
      <column caption='Quantity x Sales' datatype='integer' name='[Calculation_254383022360854528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Quantity]*[Sales per Unit]' />
      </column>
      <column caption='Discount' datatype='string' hidden='true' name='[Calculation_254383022361976833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales Price] &lt; [Sales per Unit] THEN &apos;Discounted&apos; &#10;ELSEIF  [Sales Price] = [Sales per Unit] THEN &apos;Regular&apos;&#10;ELSE &apos;Others&apos; END' />
      </column>
      <column caption='Metrics Selected' datatype='integer' name='[Calculation_254383022497943554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [Calculation_1732689601563242538]&#10;WHEN 2 THEN [Quantity]&#10;WHEN 3 THEN [Total Sales]&#10;END' />
      </column>
      <column caption='Last Updated Data' datatype='date' name='[Calculation_254383022565617670]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([Order Date])' />
      </column>
      <column caption='TRUE' datatype='boolean' name='[Calculation_2764365782074286118]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRUE' />
      </column>
      <column caption='FALSE' datatype='boolean' name='[Calculation_2764365782074298408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='FALSE' />
      </column>
      <column caption='Running Total Pareto' datatype='integer' name='[Calculation_6657868378922127360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_254383022497943554]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Pareto' datatype='integer' name='[Calculation_6657868378922377217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([Calculation_254383022497943554]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Pareto %' datatype='real' name='[Calculation_6657868378922528770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6657868378922127360]/[Calculation_6657868378922377217]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Pareto Category' datatype='string' name='[Calculation_6657868378922893315]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6657868378922528770] &lt;= [Parameters].[Parameter 7]&#10;THEN &quot;Included&quot;&#10;ELSE &quot;Excluded&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Included Pareto' datatype='integer' name='[Calculation_6657868378924179460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(IF [Calculation_6657868378922528770] &lt;= [Parameters].[Parameter 7]&#10;THEN 1&#10;ELSE 0&#10;END)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Order Id | Index' datatype='integer' name='[Calculation_6727885308800651264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
