      <column caption='Area Code' datatype='string' name='[AreaCode]' role='dimension' semantic-role='[AreaCode].[Name]' type='nominal' />
      <column caption='PY Order Amount' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;-&quot;$&quot;#,##0,,.0M' name='[CY Order Amount (copy)_3189744815566143499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Is_Current_OrderDate (copy)_3189744815565422601]&#10;    THEN [Calculation_3189744815553773568]&#10;    ELSE 0&#10;END' />
      </column>
