            <format attr='text-format' field='[federated.0iy6olz0p8biwh124ppt11a0v3kg].[avg:PY Order Quantity (copy)_3189744815574994966:qk]' value='n#,##0.00;-#,##0.00' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
