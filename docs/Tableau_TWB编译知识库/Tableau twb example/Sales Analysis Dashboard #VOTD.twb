  <worksheets>
    <worksheet name='Average Discount'>
      <layout-options>
        <caption>
          <formatted-text>
            <run>KPI Card for Average Discount

3 calculated fields used:

1. CY Discount - Calculates the Average Discount based on Select Start Date and Select End Date parameter

2. PY Discount - Calculates the Average Discount based on Previous Start Date and Previous End Date calculations

2. Discount Variance - Calculates the variance/growth rate between CY Discount and PY Discount</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Orders Sheet+ (Regional_Sales)' name='federated.0iy6olz0p8biwh124ppt11a0v3kg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Start Date' datatype='date' default-value-field='[federated.0iy6olz0p8biwh124ppt11a0v3kg].[Calculation_3189744815563874308]' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2020-01-01#'>
              <calculation class='tableau' formula='#2020-01-01#' />
            </column>
            <column caption='Select End Date' datatype='date' default-value-field='[federated.0iy6olz0p8biwh124ppt11a0v3kg].[Calculation_3189744815563567107]' name='[Select Start Date (copy)_3189744815564075013]' param-domain-type='any' role='measure' type='quantitative' value='#2020-12-30#'>
              <calculation class='tableau' formula='#2020-12-30#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iy6olz0p8biwh124ppt11a0v3kg'>
            <column caption='CY Discount' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[CY Order Amount (copy)_3189744815569444879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3189744815565062152]&#10;    THEN [DiscountApplied]&#10;    ELSE 0&#10;END' />
            </column>
            <column caption='Default End Date' datatype='date' name='[Calculation_3189744815563567107]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Fixed: MAX([OrderDate])}' />
            </column>
            <column caption='Default Start Date' datatype='datetime' datatype-customized='true' name='[Calculation_3189744815563874308]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATETRUNC(&apos;year&apos;, [Calculation_3189744815563567107]))}' />
            </column>
            <column caption='Previous Start Date' datatype='datetime' name='[Calculation_3189744815564611590]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;year&apos;,-1, [Parameters].[Parameter 1])' />
            </column>
            <column caption='Is_Current_OrderDate' datatype='boolean' name='[Calculation_3189744815565062152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[OrderDate]&gt;=[Parameters].[Parameter 1] AND [OrderDate]&lt;=[Parameters].[Select Start Date (copy)_3189744815564075013]' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Discount Applied' datatype='real' name='[DiscountApplied]' role='measure' type='quantitative' />
            <column caption='Is_Previous_OrderDate' datatype='boolean' name='[Is_Current_OrderDate (copy)_3189744815565422601]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[OrderDate]&gt;=[Calculation_3189744815564611590] AND [OrderDate]&lt;=[Previous Start Date (copy)_3189744815564857351]' />
            </column>
            <column caption='Discount Variance ' datatype='real' default-format='*▲0.00%; ▼ 0.00%; 0%' name='[Order Quantity Variance (copy)_3189744815570268179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([CY Order Amount (copy)_3189744815569444879])/AVG([PY Order Quantity (copy)_3189744815569608721]))-1' />
            </column>
            <column caption='Order Date' datatype='date' name='[OrderDate]' role='dimension' type='ordinal' />
            <column caption='PY Discount' datatype='real' default-format='n&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[PY Order Quantity (copy)_3189744815569608721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Is_Current_OrderDate (copy)_3189744815565422601]&#10;    THEN [DiscountApplied]&#10;    ELSE 0&#10;END' />
            </column>
            <column caption='Previous End Date' datatype='datetime' name='[Previous Start Date (copy)_3189744815564857351]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;year&apos;,-1, [Parameters].[Select Start Date (copy)_3189744815564075013])' />
            </column>
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='Sales Channel' datatype='string' name='[SalesChannel]' role='dimension' type='nominal' />
            <column-instance column='[CY Order Amount (copy)_3189744815569444879]' derivation='Avg' name='[avg:CY Order Amount (copy)_3189744815569444879:qk]' pivot='key' type='quantitative' />
            <column-instance column='[PY Order Quantity (copy)_3189744815569608721]' derivation='Avg' name='[avg:PY Order Quantity (copy)_3189744815569608721:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[SalesChannel]' derivation='None' name='[none:SalesChannel:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order Quantity Variance (copy)_3189744815570268179]' derivation='User' name='[usr:Order Quantity Variance (copy)_3189744815570268179:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0iy6olz0p8biwh124ppt11a0v3kg].[none:Region:nk]</column>
            <column>[federated.0iy6olz0p8biwh124ppt11a0v3kg].[none:Category:nk]</column>
            <column>[federated.0iy6olz0p8biwh124ppt11a0v3kg].[none:SalesChannel:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0iy6olz0p8biwh124ppt11a0v3kg].[avg:CY Order Amount (copy)_3189744815569444879:qk]' />
              <text column='[federated.0iy6olz0p8biwh124ppt11a0v3kg].[usr:Order Quantity Variance (copy)_3189744815570268179:qk]' />
              <text column='[federated.0iy6olz0p8biwh124ppt11a0v3kg].[avg:PY Order Quantity (copy)_3189744815569608721:qk]' />
            </encodings>
            <customized-tooltip show-buttons='false'>
              <formatted-text>
                <run fontcolor='#787878'>CY Order Amount:&#9;</run>
                <run bold='true'><![CDATA[<[federated.0iy6olz0p8biwh124ppt11a0v3kg].[avg:CY Order Amount (copy)_3189744815569444879:qk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#787878'>PY Order Amount:&#9;</run>
                <run bold='true'><![CDATA[<[federated.0iy6olz0p8biwh124ppt11a0v3kg].[avg:PY Order Quantity (copy)_3189744815569608721:qk]>]]></run>
