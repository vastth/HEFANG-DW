        <calculation class='tableau' formula='IF [Calculation_3189744815565062152]&#10;    THEN [OrderQuantity]&#10;    ELSE 0&#10;END' />
      </column>
      <column caption='CY Discount' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[CY Order Amount (copy)_3189744815569444879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3189744815565062152]&#10;    THEN [DiscountApplied]&#10;    ELSE 0&#10;END' />
      </column>
      <column caption='CY Order Amount (copy)' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;-&quot;$&quot;#,##0,,.0M' name='[CY Order Amount (copy)_3189744815607382046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3189744815565062152]&#10;    THEN [Calculation_3189744815553773568]&#10;    ELSE 0&#10;END' />
      </column>
      <column caption='CY Days to Ship' datatype='integer' default-format='n#,##0;-#,##0' name='[CY Order Quantity (copy)_3189744815574081557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3189744815565062152]&#10;    THEN [Calculation_3189744815572471828]&#10;    ELSE 0&#10;END' />
      </column>
      <column caption='Order Amount' datatype='real' name='[Calculation_3189744815553773568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[UnitCost]*[UnitPrice]' />
      </column>
      <column caption='Default End Date' datatype='date' name='[Calculation_3189744815563567107]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{Fixed: MAX([OrderDate])}' />
      </column>
      <column caption='Default Start Date' datatype='datetime' datatype-customized='true' name='[Calculation_3189744815563874308]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX(DATETRUNC(&apos;year&apos;, [Calculation_3189744815563567107]))}' />
      </column>
      <column caption='Previous Start Date' datatype='datetime' name='[Calculation_3189744815564611590]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;year&apos;,-1, [Parameters].[Parameter 1])' />
      </column>
      <column caption='Is_Current_OrderDate' datatype='boolean' name='[Calculation_3189744815565062152]' role='dimension' type='nominal'>
