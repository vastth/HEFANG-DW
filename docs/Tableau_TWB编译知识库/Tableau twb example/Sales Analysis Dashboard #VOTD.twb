    <worksheet name='Average days of shipment'>
      <layout-options>
        <caption>
          <formatted-text>
            <run>KPI Card for Order Quantity

3 calculated fields used:

1. CY Days to Ship - Calculates the Order Days to Ship based on Select Start Date and Select End Date parameter

2. PY Days to Ship - Calculates the Days to Ship based on Previous Start Date and Previous End Date calculations

2. Days to Ship Variance - Calculates the variance/growth rate between CY Days to Ship and PY Days to Ship</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Orders Sheet+ (Regional_Sales)' name='federated.0iy6olz0p8biwh124ppt11a0v3kg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Start Date' datatype='date' default-value-field='[federated.0iy6olz0p8biwh124ppt11a0v3kg].[Calculation_3189744815563874308]' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2020-01-01#'>
              <calculation class='tableau' formula='#2020-01-01#' />
            </column>
            <column caption='Select End Date' datatype='date' default-value-field='[federated.0iy6olz0p8biwh124ppt11a0v3kg].[Calculation_3189744815563567107]' name='[Select Start Date (copy)_3189744815564075013]' param-domain-type='any' role='measure' type='quantitative' value='#2020-12-30#'>
              <calculation class='tableau' formula='#2020-12-30#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iy6olz0p8biwh124ppt11a0v3kg'>
            <column caption='CY Days to Ship' datatype='integer' default-format='n#,##0;-#,##0' name='[CY Order Quantity (copy)_3189744815574081557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3189744815565062152]&#10;    THEN [Calculation_3189744815572471828]&#10;    ELSE 0&#10;END' />
            </column>
            <column caption='Default End Date' datatype='date' name='[Calculation_3189744815563567107]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Fixed: MAX([OrderDate])}' />
            </column>
            <column caption='Default Start Date' datatype='datetime' datatype-customized='true' name='[Calculation_3189744815563874308]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATETRUNC(&apos;year&apos;, [Calculation_3189744815563567107]))}' />
            </column>
            <column caption='Previous Start Date' datatype='datetime' name='[Calculation_3189744815564611590]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;year&apos;,-1, [Parameters].[Parameter 1])' />
            </column>
            <column caption='Is_Current_OrderDate' datatype='boolean' name='[Calculation_3189744815565062152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[OrderDate]&gt;=[Parameters].[Parameter 1] AND [OrderDate]&lt;=[Parameters].[Select Start Date (copy)_3189744815564075013]' />
            </column>
            <column caption='Days to ship' datatype='integer' name='[Calculation_3189744815572471828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[OrderDate],[DeliveryDate])' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Delivery Date' datatype='date' name='[DeliveryDate]' role='dimension' type='ordinal' />
            <column caption='Days to Ship Variance' datatype='real' default-format='*▲0.00%; ▼ 0.00%; 0%' name='[Discount Variance  (copy)_3189744815575150615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([CY Order Quantity (copy)_3189744815574081557])/AVG([PY Order Quantity (copy)_3189744815574994966]))-1' />
            </column>
            <column caption='Is_Previous_OrderDate' datatype='boolean' name='[Is_Current_OrderDate (copy)_3189744815565422601]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[OrderDate]&gt;=[Calculation_3189744815564611590] AND [OrderDate]&lt;=[Previous Start Date (copy)_3189744815564857351]' />
            </column>
            <column caption='Order Date' datatype='date' name='[OrderDate]' role='dimension' type='ordinal' />
            <column caption='PY Days to Ship' datatype='integer' default-format='n#,##0;-#,##0' name='[PY Order Quantity (copy)_3189744815574994966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Is_Current_OrderDate (copy)_3189744815565422601]&#10;    THEN [Calculation_3189744815572471828]&#10;    ELSE 0&#10;END' />
            </column>
            <column caption='Previous End Date' datatype='datetime' name='[Previous Start Date (copy)_3189744815564857351]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;year&apos;,-1, [Parameters].[Select Start Date (copy)_3189744815564075013])' />
            </column>
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='Sales Channel' datatype='string' name='[SalesChannel]' role='dimension' type='nominal' />
            <column-instance column='[CY Order Quantity (copy)_3189744815574081557]' derivation='Avg' name='[avg:CY Order Quantity (copy)_3189744815574081557:qk]' pivot='key' type='quantitative' />
            <column-instance column='[PY Order Quantity (copy)_3189744815574994966]' derivation='Avg' name='[avg:PY Order Quantity (copy)_3189744815574994966:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
