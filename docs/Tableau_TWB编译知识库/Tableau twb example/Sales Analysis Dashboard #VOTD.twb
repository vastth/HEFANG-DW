                <run fontcolor='#787878'>Order Amount Variance:&#9;</run>
                <run bold='true'><![CDATA[<[federated.0iy6olz0p8biwh124ppt11a0v3kg].[usr:Order Quantity Variance (copy)_3189744815570268179:qk]>]]></run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run fontalignment='0' fontcolor='#131bb6' fontsize='20'><![CDATA[<[federated.0iy6olz0p8biwh124ppt11a0v3kg].[avg:CY Order Amount (copy)_3189744815569444879:qk]>]]></run>
                <run fontalignment='0' fontcolor='#131bb6' fontsize='20'>Æ </run>
                <run fontalignment='0'><![CDATA[<[federated.0iy6olz0p8biwh124ppt11a0v3kg].[usr:Order Quantity Variance (copy)_3189744815570268179:qk]>]]></run>
                <run fontalignment='0'>&#10;vs PY </run>
                <run fontalignment='0'><![CDATA[<[federated.0iy6olz0p8biwh124ppt11a0v3kg].[avg:PY Order Quantity (copy)_3189744815569608721:qk]>]]></run>
