      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='updated_marketing_activities_dataset_2022_2023' name='federated.0w7ow2h0jgfjop1255ixj13oc5m2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Year Parameter' datatype='integer' default-format='n0;-0' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
            <column alias='Impressions' caption='Metrics Selector' datatype='string' datatype-customized='true' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Impressions&quot;'>
              <calculation class='tableau' formula='&quot;Impressions&quot;' />
              <aliases>
                <alias key='&quot;Clicks&quot;' value='Clicks' />
                <alias key='&quot;Conversion Rate&quot;' value='Conversion Rate' />
                <alias key='&quot;Cost per Conversion&quot;' value='Cost per Conversion' />
                <alias key='&quot;Impressions&quot;' value='Impressions' />
                <alias key='&quot;Revenue&quot;' value='Revenue' />
                <alias key='&quot;ROI&quot;' value='ROI' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0w7ow2h0jgfjop1255ixj13oc5m2'>
            <column datatype='date' name='[Activity Date]' role='dimension' type='ordinal' />
            <column caption='Selected Year' datatype='boolean' name='[Calculation_343751336030351361]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([Activity Date]) = [Parameters].[Parameter 1 1]' />
            </column>
            <column caption='Marketing metrics' datatype='real' name='[Calculation_6493768465418375168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Impressions&apos; THEN SUM([Impressions])&#10;WHEN &apos;Clicks&apos; THEN SUM([Clicks])&#10;WHEN &apos;Cost per Conversion&apos; THEN SUM([Cost])/SUM([Conversions])&#10;WHEN &apos;Conversion Rate&apos; THEN AVG([Conversion Rate])&#10;WHEN &apos;Revenue&apos; THEN SUM([Revenue])&#10;WHEN &apos;ROI&apos; THEN SUM([ROI])&#10;END' />
            </column>
            <column datatype='integer' name='[Clicks]' role='measure' type='quantitative' />
            <column datatype='real' name='[Conversion Rate]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Conversions]' role='measure' type='quantitative' />
            <column datatype='real' name='[Cost]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Impressions]' role='measure' type='quantitative' />
            <column caption='Marketing metrics Label' datatype='string' name='[Marketing metrics (copy)_6493768465429946370]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;Impressions&apos; THEN &#10;        IF LEN(STR(SUM([Impressions]))) &gt; 6 THEN&#10;            LEFT(STR(SUM([Impressions])), LEN(STR(SUM([Impressions]))) - 6) + &quot;,&quot; +&#10;            MID(STR(SUM([Impressions])), LEN(STR(SUM([Impressions]))) - 5, 3) + &quot;,&quot; +&#10;            RIGHT(STR(SUM([Impressions])), 3)&#10;        ELSEIF LEN(STR(SUM([Impressions]))) &gt; 3 THEN&#10;            LEFT(STR(SUM([Impressions])), LEN(STR(SUM([Impressions]))) - 3) + &quot;,&quot; +&#10;            RIGHT(STR(SUM([Impressions])), 3)&#10;        ELSE&#10;            STR(SUM([Impressions]))&#10;        END&#10;    WHEN &apos;Clicks&apos; THEN &#10;        IF LEN(STR(SUM([Clicks]))) &gt; 6 THEN&#10;            LEFT(STR(SUM([Clicks])), LEN(STR(SUM([Clicks]))) - 6) + &quot;,&quot; +&#10;            MID(STR(SUM([Clicks])), LEN(STR(SUM([Clicks]))) - 5, 3) + &quot;,&quot; +&#10;            RIGHT(STR(SUM([Clicks])), 3)&#10;        ELSEIF LEN(STR(SUM([Clicks]))) &gt; 3 THEN&#10;            LEFT(STR(SUM([Clicks])), LEN(STR(SUM([Clicks]))) - 3) + &quot;,&quot; +&#10;            RIGHT(STR(SUM([Clicks])), 3)&#10;        ELSE&#10;            STR(SUM([Clicks]))&#10;        END&#10;    WHEN &apos;Cost per Conversion&apos; THEN &quot;$&quot; + STR(ROUND(SUM([Cost]) / SUM([Conversions]), 1))&#10;    WHEN &apos;Conversion Rate&apos; THEN STR(ROUND(AVG([Conversion Rate]) * 100, 1)) + &quot;%&quot;&#10;    WHEN &apos;Revenue&apos; THEN &#10;        IF LEN(STR(INT(SUM([Revenue])))) &gt; 6 THEN&#10;            &quot;$&quot; + LEFT(STR(INT(SUM([Revenue]))), LEN(STR(INT(SUM([Revenue])))) - 6) + &quot;,&quot; +&#10;            MID(STR(INT(SUM([Revenue]))), LEN(STR(INT(SUM([Revenue])))) - 5, 3) + &quot;,&quot; +&#10;            RIGHT(STR(INT(SUM([Revenue]))), 3)&#10;        ELSEIF LEN(STR(INT(SUM([Revenue])))) &gt; 3 THEN&#10;            &quot;$&quot; + LEFT(STR(INT(SUM([Revenue]))), LEN(STR(INT(SUM([Revenue])))) - 3) + &quot;,&quot; +&#10;            RIGHT(STR(INT(SUM([Revenue]))), 3)&#10;        ELSE&#10;            &quot;$&quot; + STR(INT(SUM([Revenue])))&#10;        END&#10;    WHEN &apos;ROI&apos; THEN &#10;        IF LEN(STR(INT(SUM([ROI])))) &gt; 6 THEN&#10;            &quot;$&quot; + LEFT(STR(INT(SUM([ROI]))), LEN(STR(INT(SUM([ROI])))) - 6) + &quot;,&quot; +&#10;            MID(STR(INT(SUM([ROI]))), LEN(STR(INT(SUM([ROI])))) - 5, 3) + &quot;,&quot; +&#10;            RIGHT(STR(INT(SUM([ROI]))), 3)&#10;        ELSEIF LEN(STR(INT(SUM([ROI])))) &gt; 3 THEN&#10;            &quot;$&quot; + LEFT(STR(INT(SUM([ROI]))), LEN(STR(INT(SUM([ROI])))) - 3) + &quot;,&quot; +&#10;            RIGHT(STR(INT(SUM([ROI]))), 3)&#10;        ELSE&#10;            &quot;$&quot; + STR(INT(SUM([ROI])))&#10;        END&#10;END' />
            </column>
            <column datatype='real' name='[ROI]' role='measure' type='quantitative' />
            <column datatype='real' name='[Revenue]' role='measure' type='quantitative' />
            <column datatype='string' name='[Source]' role='dimension' type='nominal' />
            <column datatype='string' name='[Visibility]' role='dimension' type='nominal' />
