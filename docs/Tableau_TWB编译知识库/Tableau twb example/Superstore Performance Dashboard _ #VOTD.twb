      <repository-location derived-from='http://localhost:9100/workbooks/SuperstorePerformanceDashboard_17701564064270/profitkpigraph?rev=' id='126542534' path='/workbooks/SuperstorePerformanceDashboard_17701564064270' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='Orders+ (superstore data)' name='federated.13f8nh10yi0a3513jzdak0fze7js' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='2025' caption='Select Year Param' datatype='real' default-format='*' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025.'>
              <calculation class='tableau' formula='2025.' />
              <aliases>
                <alias key='2023.' value='2023' />
                <alias key='2024.' value='2024' />
                <alias key='2025.' value='2025' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13f8nh10yi0a3513jzdak0fze7js'>
            <column caption='CY Max Profit for Top' datatype='real' name='[CY Max Sales for Top (copy)_2414489557528592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :&#10;    MAX(&#10;        { FIXED MONTH([Order Date]) :&#10;            SUM(&#10;                IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#10;                THEN [Profit]&#10;                END&#10;            )&#10;        }&#10;    )&#10;}' />
            </column>
            <column caption='CY Profit' datatype='real' name='[CY Sales (copy)_2414489557291021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_2414489498263552]&#10;THEN [Profit]&#10;END' />
            </column>
            <column caption='CY Profit for Top' datatype='real' name='[CY Sales for Top (copy)_2414489557356558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Monthly Sales (Selected Year)&#10;{ FIXED MONTH([Order Date]) :&#10;    SUM(&#10;        IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#10;        THEN [Profit]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='PY For Label' datatype='integer' name='[Calculation_1445821179240453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(YEAR([Order Date]))-1' />
            </column>
            <column caption='Is Current Year' datatype='boolean' name='[Calculation_2414489498263552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([Order Date]) = [Parameters].[Parameter 1]' />
            </column>
            <column caption='Year Selector' datatype='boolean' name='[Calculation_2414489503784967]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([Order Date]) IN (&#10;    [Parameters].[Parameter 1],&#10;    [Parameters].[Parameter 1] - 1&#10;)' />
            </column>
            <column caption='Month for Graph Label' datatype='string' name='[Calculation_2414489511452683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Order Date])' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Is Previous Year' datatype='boolean' name='[Is Current Year (copy)_2414489498406913]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([Order Date]) = [Parameters].[Parameter 1] - 1' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column caption='PY Profit' datatype='real' name='[PY Sales (copy)_2414489557458959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Is Current Year (copy)_2414489498406913]&#10;THEN [Profit]&#10;END' />
            </column>
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='State Abbr' datatype='string' name='[State_Abbr]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Top Profit Month' datatype='string' name='[Top Sales Month (copy)_6290610919104522]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [CY Sales for Top (copy)_2414489557356558] = [CY Max Sales for Top (copy)_2414489557528592] THEN &quot;Highest&quot;&#10;ELSEIF [CY Sales for Top (copy)_2414489557356558] &lt; 0 THEN &quot;Negative&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
            </column>
