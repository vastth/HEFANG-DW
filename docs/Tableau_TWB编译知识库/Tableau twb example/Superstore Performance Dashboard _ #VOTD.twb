            <column caption='Order Detail Year Filter' datatype='boolean' name='[Calculation_1323501634789381]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = STR(YEAR([Order Date])) OR [Parameters].[Parameter 5] = &quot;All&quot;' />
