            <column caption='Month for Graph Label' datatype='string' name='[Calculation_2414489511452683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Order Date])' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Is Previous Year' datatype='boolean' name='[Is Current Year (copy)_2414489498406913]' role='dimension' type='nominal'>
