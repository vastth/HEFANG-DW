      <aliases enabled='yes' />
      <column caption='Row' datatype='integer' name='[Calculation_1677450163266510848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='int((index()-1)/(round(sqrt(size()))))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Positive Profit' datatype='boolean' name='[Calculation_1677450163267637250]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Profit])&gt;0' />
      </column>
      <column caption='Max Month' datatype='datetime' name='[Calculation_1677450163269058563]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED :DATETRUNC(&apos;month&apos;, MAX([Order Date]))}' />
      </column>
      <column caption='Selected Month Profit' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[Calculation_1677450163269414916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[Order Date])=[Parameters].[Order Date Month Parameter]&#10;THEN [Profit] END' />
      </column>
      <column caption='Change selected to prior month profit' datatype='string' name='[Calculation_1677450163270189062]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_1677450163269414916])&gt;=SUM([Max Month Profit (copy)_1677450163269660677])&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos;&#10;END' />
      </column>
      <column caption='Neg Selected Month Profit Indicator' datatype='string' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_1677450163271843847]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_1677450163269414916])&lt;0 THEN &apos;●&apos; END' />
      </column>
      <column caption='Order Date Month' datatype='date' datatype-customized='true' name='[Calculation_1677450163277619212]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[Order Date]))' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1677450163279503373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Selected Month/Year' datatype='boolean' name='[Calculation_1677450163282120719]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1677450163277619212]=[Parameters].[Order Date Month Parameter]' />
      </column>
      <column caption='Avg Profit/Customer' datatype='real' name='[Calculation_1677450163358396432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/COUNTD([Customer ID])' />
      </column>
      <column caption='Sales Rank by Customer' datatype='boolean' name='[Calculation_1677450163363762197]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM({INCLUDE [Customer Name]:SUM([Sales])}))&gt;5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Customer Set Calc' datatype='boolean' name='[Calculation_1677450163371487256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Customer Set]' />
      </column>
      <column caption='Selected Month Dot' datatype='real' name='[Calculation_1677450163513745434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1677450163277619212]=[Parameters].[Order Date Month Parameter] THEN ([Profit]) END' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Customer Name]' role='dimension' type='nominal' />
      <column caption='Prior to Selected Month Profit' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Max Month Profit (copy)_1677450163269660677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[Order Date])=DATEADD(&apos;month&apos;,-1,[Parameters].[Order Date Month Parameter])&#10;THEN [Profit] END' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
      <column caption='Positive Profit (copy)' datatype='boolean' name='[Positive Profit (copy)_1677450163372126233]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Profit])&gt;0' />
      </column>
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column datatype='string' name='[Region]' role='dimension' type='nominal' />
      <column caption='Column' datatype='real' name='[Row (copy)_1677450163266568193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(index()-1)%(round(sqrt(size())))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
