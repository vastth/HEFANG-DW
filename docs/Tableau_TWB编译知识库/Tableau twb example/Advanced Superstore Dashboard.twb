          <datasource-dependencies datasource='Parameters'>
            <column caption='Order Date Month Parameter' datatype='date' name='[Order Date Month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2019-12-01#'>
              <calculation class='tableau' formula='#2019-12-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1t1dlr9104owf81c906x81vvy9f6'>
            <column caption='Order Date Month' datatype='date' datatype-customized='true' name='[Calculation_1677450163277619212]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[Order Date]))' />
            </column>
            <column caption='Profit Ratio' datatype='real' name='[Calculation_1677450163279503373]' role='measure' type='quantitative'>
