@echo off
REM ========================================================================
REM 何方珠宝 - 门店日报专题调度脚本（Windows）
REM 用于 Windows 任务计划程序调度 NAS 目标导入链路
REM 支持参数透传，例如：
REM   run_scheduled_store_daily_report.bat --rerun-report-date 2026-06-07 --rerun-data-version v1
REM ========================================================================

chcp 65001 >nul
cd /d %~dp0

echo ========================================================================
echo   何方珠宝门店日报专题调度
echo   开始时间: %date% %time%
if not "%~1"=="" echo   附加参数: %*
echo ========================================================================

python scheduled_store_daily_report.py %*

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ✓ 门店日报专题调度执行成功
    echo ========================================================================
    exit /b 0
) else (
    echo.
    echo ✗ 门店日报专题调度执行失败，错误码: %ERRORLEVEL%
    echo ========================================================================
    exit /b %ERRORLEVEL%
)